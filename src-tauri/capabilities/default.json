  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "步步各窗口使用的权限",
  "windows": ["pet", "panel", "guest-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
